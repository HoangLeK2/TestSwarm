# Root .env — single source of truth for docker compose + farm container.
# Copy to `.env` and fill in. Compose reads this for variable substitution AND
# injects it into the `farm` container via env_file.

# ─── Database (docker-compose.yml `postgres` service) ─────────────────────────
# In-compose (farm/temporal containers): DB_HOST=postgres, DB_PORT=5432
# From host (psql, agent-boot, bare-metal farm): localhost + DB_PORT_PUBLISHED
DB_HOST=postgres
DB_PORT=5432
DB_PORT_PUBLISHED=5433
DB_NAME=device_farm
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=12
DB_MAX_OVERFLOW=3
DB_ACTIVITY_POOL_SIZE=4
DB_ACTIVITY_MAX_OVERFLOW=0
# Set this to the target PostgreSQL max_connections. 0 keeps validation advisory.
DB_CONNECTION_LIMIT=100
DB_CONNECTION_RESERVE=15
# Conservative aggregate allowance for Temporal when it shares PostgreSQL.
TEMPORAL_DB_MAX_CONNECTIONS=40
TEMPORAL_SQL_MAX_CONNS=5
TEMPORAL_SQL_MAX_IDLE_CONNS=5
TEMPORAL_SQL_VIS_MAX_CONNS=3
TEMPORAL_SQL_VIS_MAX_IDLE_CONNS=3
TEMPORAL_WORKER_COUNT=7
TEMPORAL_WORKER_MAX_CONCURRENT_ACTIVITIES=20
TEMPORAL_WORKER_MAX_CONCURRENT_WORKFLOWS=60
METRICS_ENABLED=0
# Required when METRICS_ENABLED=1; configure Prometheus with a Bearer token.
METRICS_TOKEN=
# Outbox claim recovery window. Published events are acknowledged in bulk.
EXECUTION_EVENT_OUTBOX_LEASE_SECONDS=30
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/device_farm
# Bare-metal backend / agent-boot on host:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/device_farm

# ─── Auth (JWT) ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_EXPIRE_HOURS=1
REFRESH_EXPIRE_DAYS=30
# JWT_ALGORITHM=HS256
# ACCOUNT_ENCRYPTION_KEY=
# ACCOUNT_DAILY_USAGE_LIMIT=30
# ACCOUNT_COOLDOWN_MINUTES=120

# ─── Account action ledger ───────────────────────────────────────────────────
ACCOUNT_ACTION_LEDGER_MODE=disabled
ACCOUNT_ACTION_RECONCILE_INTERVAL_SECONDS=60
ACCOUNT_ACTION_RECONCILE_STALE_AFTER_SECONDS=3600

# ─── Account profile history (account_events) ────────────────────────────────
# Requires PostgreSQL (DATABASE_URL or database.enabled in config.yaml).
# ACCOUNT_HISTORY_ENABLED=true
# ACCOUNT_HISTORY_MAX_BATCH=100
# ACCOUNT_HISTORY_MAX_PENDING=1000

# ─── Server / main ───────────────────────────────────────────────────────────
FARM_CONFIG=config.yaml
FARM_RELOAD=0
FARM_AGENT_BOOT=1
# FARM_FRONTEND_DIST=

# ─── Safe mode (observe-only deployment) ─────────────────────────────────────
# FARM_READ_ONLY=1         # reject POST/PUT/PATCH/DELETE + WS write frames
#                          # (tap/swipe/key/install …). Auth + GET still work.
# FARM_STREAM_HIERARCHY=0  # disable /hierarchy, /ui_elements, /hit_test to
#                          # save bandwidth on observe-only dashboards.
# Overrides YAML `safe_mode.read_only` / `safe_mode.stream_hierarchy`.
# Both default OFF. Front-end reads GET /api/server/safe-mode to hide write UI.

# ─── Device Farm backend URL (cho MCP / agent tự gọi về) ────────────────────
DEVICE_FARM_URL=http://localhost:8081
MCP_AUTH_TOKEN=
# Casbin RBAC policies are DB-backed; each worker caches policy snapshots.
# DEVICE_FARM_RBAC_POLICY_CACHE_TTL_SECONDS=30
# DEVICE_FARM_RBAC_ENFORCER_CACHE_SIZE=4096

# ─── Frontend (Next.js) ──────────────────────────────────────────────────────
# Biến NEXT_PUBLIC_* được bake vào bundle LÚC BUILD → rebuild frontend sau khi đổi.
# HTTP API: gọi thẳng farm backend để tránh proxy Next.
NEXT_PUBLIC_PRODUCT_API_URL=http://localhost:8081
# WebSocket: trình duyệt kết nối thẳng tới farm (port publish 8081), không qua Next proxy.
NEXT_PUBLIC_DEVICE_FARM_WS_URL=ws://localhost:8081/ws
# Control scenario editor: `map` = XYFlow free-layout canvas, `flowgram` = experimental FlowGram fixed-layout canvas, `list` = legacy list fallback.
NEXT_PUBLIC_DEVICE_FARM_CONTROL_EDITOR=map
# Device-farm grid: load all tile previews without scroll (1=on). Set 0 to save bandwidth.
# NEXT_PUBLIC_DEVICE_FARM_GRID_PREVIEW_EAGER=1
# MJPEG preview FPS on grid only when backend enables dashboard_grid_preview_mjpeg.
# NEXT_PUBLIC_DEVICE_FARM_PREVIEW_FPS=1
# Simultaneous H264 canvas decodes on grid (0–4, default 4).
# NEXT_PUBLIC_DEVICE_FARM_GRID_H264_LIMIT=4
NEXT_PUBLIC_ENVIRONMENT=dev
# Next rewrites `/api/*` → farm. Phải có LÚC `docker compose build` (build-arg) và runtime.
DEVICE_FARM_BACKEND_URL=http://farm:8081
# Stream low-bandwidth mode
LOW_BW_MODE=true
LOW_BW_FRAME_SKIP=2
# Sentry (tuỳ chọn)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DISABLED=1
# NEXT_PUBLIC_SENTRY_ORG=
# NEXT_PUBLIC_SENTRY_PROJECT=


# ─── Ngrok ───────────────────────────────────────────────────────────────────
NGROK_ENABLED=0
NGROK_AUTHTOKEN=

# ─── Temporal ────────────────────────────────────────────────────────────────
# TEMPORAL_SERVER_URL is set to `temporal:7233` by compose for the farm container.
# TEMPORAL_NAMESPACE=
# TEMPORAL_TASK_QUEUE=

# ─── Relay (gRPC) ────────────────────────────────────────────────────────────
RELAY_API_KEY=
RELAY_AGENT_OWNERSHIP_REQUIRED=true
RELAY_PORT=50051
# RELAY_SERVER=localhost:50051  # chỉ cho agent-boot chạy ngoài compose
# RELAY_ENROLLMENT_TOKEN=       # tạo trong UI Relay Agents, dùng cho agent-boot

# ─── Redis (shared state cache) ──────────────────────────────────────────────
# Setting REDIS_URL auto-enables redis. Leave blank to run in-memory only.
# In compose: redis://redis:6379/0   (service name from docker-compose.yml)
# Outside compose: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
# REDIS_PREFIX=df:   # only via YAML `redis.prefix`; env override not wired
# Web UI: docker compose up redis-ui → http://localhost:${REDIS_UI_PORT:-5540}
# REDIS_UI_PORT=5540

# ─── AI / Scenario ───────────────────────────────────────────────────────────
SCENARIO_AI_BACKEND=llm
AI_MCP_URL=http://localhost:4000
SCENARIO_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# OPENAI_VISION_MODEL=gpt-4o-mini
# GEMINI_VISION_MODEL=gemini-2.0-flash
SCENARIO_UI_XML_MAX_CHARS=20000
SCENARIO_UI_XML_MAX_CHARS_PER_SCREEN=15000
# SCENARIO_DEBUG_JSON_PATH=

# ─── Edge extra-data extraction ──────────────────────────────────────────────
# Scenario extract steps can ask the phone/APK to send u2 XML directly to
# agent-boot, where content parsing + content_items inserts happen.
EDGE_EXTRA_DATA_ENABLED=1
EDGE_EXTRA_APPLY_GLOBALLY=0
# Must be reachable from the phone/APK on the LAN/VPN (not 127.0.0.1 on the device).
EDGE_EXTRA_AGENT_URL=http://192.168.1.10:8765
# Local dev on one PC: keep loopback above and set your LAN IP here (same port).
# EDGE_EXTRA_AGENT_PUBLIC_URL=http://192.168.1.10:8765
EDGE_EXTRA_AGENT_URL_ALLOWLIST=http://192.168.1.10:8765
EDGE_EXTRA_TOKEN=change-me-extra-token
EDGE_EXTRA_TIMEOUT_S=90
# EDGE_EXTRA_ALLOW_UNAUTH=0
# EDGE_EXTRA_ALLOW_STEP_ENDPOINT=0

# ─── Scenario runtime debug ──────────────────────────────────────────────────
# CAPTURE_STEPS=0
# DEBUG_AUTO=0
# CAPTURE_PRE_STEP=0

# ─── Campaign throughput ────────────────────────────────────────────────────
# 100-phone campaign should start in one wave; lower these if DB/Temporal
# pressure is higher than the phone/agent bottleneck.
CAMPAIGN_RUNTIME_START_CONCURRENCY=100
CAMPAIGN_DISPATCH_FANOUT_CONCURRENCY=100

# ─── Agent / device ──────────────────────────────────────────────────────────
# Phone-facing WS for push-connect-url / batch jobs (when dashboard does not pass ws_base_url).
# Must be reachable from the device (LAN IP), not 127.0.0.1 unless adb reverse is set up.
# DEVICE_FARM_WS=ws://172.16.0.182:8081/device-agent
DEVICE_FARM_U2_ALWAYS_TUNNEL=1
DEVICE_FARM_SCRCPY_JAR=/usr/share/scrcpy/scrcpy-server
DEVICE_FARM_WEBRTC_ENABLED=1
# Production: local media-adapter opens outbound gRPC to cloud backend, then
# pushes H264 directly to cloud go2rtc. HTTP URL is local/dev fallback only.
MEDIA_ADAPTER_CONTROL_PLANE=grpc
DEVICE_FARM_GO2RTC_URL=http://go2rtc:1984
MEDIA_WEBRTC_SIGNALING_PLANE=backend
MEDIA_ADAPTER_HTTP_URL=http://host.docker.internal:8878
# Optional go2rtc Docker overrides.
GO2RTC_IMAGE=ghcr.io/alexxit/go2rtc:1.9.14
GO2RTC_API_PORT=1984
GO2RTC_RTSP_PORT=8554
GO2RTC_WEBRTC_PORT=8555
# SCRCPY_JAR=
# SCRCPY_ADB_BIN=adb
# DISABLE_U2=
# LOW_BW_MODE=0
# LOW_BW_FRAME_SKIP=10
# U2_KEEPALIVE_INTERVAL=5.0
# DEVICE_FARM_CV_CONCURRENCY=4
# DEVICE_FARM_HEALING_ENABLED=1
# SCRCPY_AUTO_STOP_IDLE_S=60

# ─── Cloudflare R2 / S3 ──────────────────────────────────────────────────────
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=device-farm
R2_PUBLIC_BASE_URL=
R2_SECURE=
R2_PUBLIC_URL_INCLUDE_BUCKET=
R2_REGION=
OBJECT_STORAGE_MAX_CONCURRENT_UPLOADS=8
# Debug only. Production image captures require MinIO/R2/S3 upload success.
DEVICE_FARM_LOCAL_IMAGE_FALLBACK_ENABLED=false
# Legacy MinIO fallback: MINIO_ENDPOINT, MINIO_ACCESS_KEY, MINIO_SECRET_KEY, MINIO_BUCKET, MINIO_PUBLIC_BASE_URL, MINIO_SECURE
#
# ─── Docker Compose MinIO (profile `minio`, dev local — cloud dùng R2) ───────
#   docker compose --profile minio up -d
#   docker compose --profile minio run --rm minio-init   # public GET (một lần)
# Tắt object storage: MINIO_ENDPOINT=
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=device-farm
# MINIO_SECURE=false
# MINIO_PUBLIC_BASE_URL=http://localhost:9000
# MINIO_PUBLIC_URL_INCLUDE_BUCKET=true  # URL = {base}/{bucket}/content-screenshots/…jpg
# Production R2: bật public access trên bucket + R2_PUBLIC_BASE_URL (farm không phụ thuộc minio-init).
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001

# Content crawl: lưu ảnh full-screen lên object storage (cần R2_* + quyền ghi).
# Bật để farm gửi capture_screenshot=true sang agent-boot và attach URL sau extract.
DEVICE_FARM_CONTENT_IMAGES_ENABLED=1
# Front-end: hiển thị screenshot_path R2 + rewrite URL MinIO cũ (localhost:9000)
# NEXT_PUBLIC_OBJECT_STORAGE_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
