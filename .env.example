# Root .env — single source of truth for docker compose + farm container.
# Copy to `.env` and fill in. Compose reads this for variable substitution AND
# injects it into the `farm` container via env_file.

# ─── Database (external Postgres by default) ─────────────────────────────────
# On Docker Desktop (Mac/Windows), host.docker.internal → the host machine.
# On Linux, compose adds host-gateway, or use the host's LAN IP.
# To use in-compose Postgres: uncomment service in docker-compose.yml, set DB_HOST=postgres.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=device_farm
DB_USER=postgres
DB_PASSWORD=postgres
# Optional: full URL overrides DB_* pieces above.
# DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/device_farm

# ─── Auth (JWT) ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_EXPIRE_HOURS=1
REFRESH_EXPIRE_DAYS=30
# JWT_ALGORITHM=HS256
# ACCOUNT_ENCRYPTION_KEY=
# ACCOUNT_DAILY_USAGE_LIMIT=30
# ACCOUNT_COOLDOWN_MINUTES=120

# ─── Server / main ───────────────────────────────────────────────────────────
FARM_CONFIG=config.yaml
FARM_RELOAD=0
FARM_AGENT_BOOT=1
# FARM_FRONTEND_DIST=

# ─── Device Farm backend URL (cho MCP / agent tự gọi về) ────────────────────
DEVICE_FARM_URL=http://localhost:8081
DEVICE_FARM_MCP_TOKEN=
# MCP_AUTH_TOKEN=

# ─── Frontend (Next.js) ──────────────────────────────────────────────────────
# Biến NEXT_PUBLIC_* được bake vào bundle LÚC BUILD → browser dùng.
# Phải là URL truy cập được TỪ TRÌNH DUYỆT (host IP/domain), KHÔNG phải tên service docker.
NEXT_PUBLIC_PRODUCT_API_URL=http://host.docker.internal:8081
NEXT_PUBLIC_DEVICE_FARM_WS_URL=ws://host.docker.internal:8081/ws
NEXT_PUBLIC_ENVIRONMENT=dev
# Backend URL cho Next server-side rewrites/proxy (chạy trong container → dùng service name).
DEVICE_FARM_BACKEND_URL=http://farm:8081
# Stream low-bandwidth mode
LOW_BW_MODE=true
LOW_BW_FRAME_SKIP=2
# Sentry (tuỳ chọn)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DISABLED=1
# NEXT_PUBLIC_SENTRY_ORG=
# NEXT_PUBLIC_SENTRY_PROJECT=


# ─── Ngrok ───────────────────────────────────────────────────────────────────
NGROK_ENABLED=0
NGROK_AUTHTOKEN=

# ─── Temporal ────────────────────────────────────────────────────────────────
# TEMPORAL_SERVER_URL is set to `temporal:7233` by compose for the farm container.
# TEMPORAL_NAMESPACE=
# TEMPORAL_TASK_QUEUE=

# ─── Relay (gRPC) ────────────────────────────────────────────────────────────
RELAY_API_KEY=
RELAY_PORT=50051
# RELAY_SERVER=localhost:8081  # chỉ cho agent-boot chạy ngoài compose

# ─── AI / Scenario ───────────────────────────────────────────────────────────
SCENARIO_AI_BACKEND=llm
AI_MCP_URL=http://localhost:4000
SCENARIO_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# OPENAI_VISION_MODEL=gpt-4o-mini
# GEMINI_VISION_MODEL=gemini-2.0-flash
SCENARIO_UI_XML_MAX_CHARS=20000
SCENARIO_UI_XML_MAX_CHARS_PER_SCREEN=15000
# SCENARIO_DEBUG_JSON_PATH=

# ─── Scenario runtime debug ──────────────────────────────────────────────────
# CAPTURE_STEPS=0
# DEBUG_AUTO=0
# CAPTURE_PRE_STEP=0

# ─── Agent / device ──────────────────────────────────────────────────────────
# DEVICE_FARM_WS=ws://localhost:8081/device-agent
DEVICE_FARM_U2_ALWAYS_TUNNEL=1
DEVICE_FARM_SCRCPY_JAR=/usr/share/scrcpy/scrcpy-server
# SCRCPY_JAR=
# SCRCPY_ADB_BIN=adb
# DISABLE_U2=
# LOW_BW_MODE=0
# LOW_BW_FRAME_SKIP=10
# U2_KEEPALIVE_INTERVAL=5.0
# DEVICE_FARM_CV_CONCURRENCY=4
# DEVICE_FARM_HEALING_ENABLED=1

# ─── Cloudflare R2 / S3 ──────────────────────────────────────────────────────
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=device-farm
R2_PUBLIC_BASE_URL=
R2_SECURE=
R2_PUBLIC_URL_INCLUDE_BUCKET=
R2_REGION=
# Legacy MinIO fallback: MINIO_ENDPOINT, MINIO_ACCESS_KEY, MINIO_SECRET_KEY, MINIO_BUCKET, MINIO_PUBLIC_BASE_URL, MINIO_SECURE
