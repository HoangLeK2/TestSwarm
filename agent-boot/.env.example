# Copy this file to .env and fill in the values
# cp .env.example .env

# Relay transport mode: ws | grpc
# grpc is recommended for stability/performance.
RELAY_MODE=grpc

# Relay server endpoint:
# - grpc mode: host:50051
# - ws mode:   host:8081 (or full ws://.../relay-agent URL)
# Examples:
#   Farm on this machine (Docker maps 50051): localhost:50051
#   Farm on remote VPS:                        your-vps.example.com:50051
RELAY_SERVER=localhost:50051

# API key — must match device_farm relay.api_key / Docker RELAY_API_KEY
RELAY_API_KEY=

# User-scoped ownership token — create it from the Relay Agents page.
RELAY_ENROLLMENT_TOKEN=

# Default: do not reinstall uiautomator2 APKs when both packages already exist.
# Set to 1 only when intentionally refreshing/replacing those APKs.
AGENT_BOOT_FORCE_U2_INSTALL=0

# PA B edge extract: relay command extra_data + u2 dump + in-process ingest (required).
U2_BATCH_ENABLED=true
AGENT_BOOT_CONTENT_DB_ENABLED=1

# Optional HTTP ingest (debug / legacy). PA B relay path does not use phone POST.
# AGENT_BOOT_EXTRA_ENABLED=1
AGENT_BOOT_EXTRA_ENABLED=0
AGENT_BOOT_EXTRA_HOST=0.0.0.0
AGENT_BOOT_EXTRA_PORT=8765
AGENT_BOOT_EXTRA_TOKEN=change-me-extra-token
# AGENT_BOOT_EXTRA_ALLOW_UNAUTH=0
AGENT_BOOT_XML_MAX_BYTES=8388608
AGENT_BOOT_XML_PARSE_WORKERS=4
AGENT_BOOT_CONTENT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/device_farm
AGENT_BOOT_CONTENT_DB_POOL_SIZE=2
AGENT_BOOT_CONTENT_DB_COMMAND_TIMEOUT=10
# AGENT_BOOT_CONTENT_DB_RETRIES=3
# AGENT_BOOT_CONTENT_DB_RETRY_BASE_DELAY=0.2

# Facebook parser tuning (optional)
# FB_KEEP_SOFT_JUNK=0
# FB_EXTRACT_TRUNCATION_MARKERS=

# Scrcpy stability tuning (OEM codecs can stall on static screens)
# Dashboard browser decodes H.264 only — keep SCRCPY_VIDEO_CODEC=h264 unless you add HEVC decode.
# SCRCPY_VIDEO_CODEC=h264
# SCRCPY_VIDEO_ENCODER=
# Per-device: SCRCPY_VIDEO_ENCODER__10AE7S00HD002JK=c2.qti.avc.encoder
# SCRCPY_VIVO_H264_ENCODER=c2.qti.avc.encoder
# SCRCPY_FRAME_TIMEOUT_S=30
# SCRCPY_IDR_REQUEST_AFTER_S=2.5
# HEVC auto-fallback is opt-in (empty default). Web UI stays black if HEVC is enabled without a decoder.
# SCRCPY_HEVC_OEM_ALLOWLIST=vivo,oppo,realme,oneplus
