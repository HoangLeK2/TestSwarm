# Copy this file to .env and fill in the values
# cp .env.example .env

# WebSocket relay — same host:port as device_farm HTTP (uvicorn), path /relay-agent is added automatically.
# Examples:
#   Farm on this machine (Docker maps 8081):  localhost:8081
#   Farm on remote VPS:                       your-vps.example.com:8081
# Full URL also works:                        ws://localhost:8081/relay-agent
RELAY_SERVER=localhost:8081

# API key — must match device_farm relay.api_key / Docker RELAY_API_KEY
RELAY_API_KEY=
