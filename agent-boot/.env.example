# Agent-boot — relay + optional extra-data HTTP ingest (debug only).
#
# Docker + USB on host: ADB server must listen globally (not localhost-only):
#   adb kill-server && adb -a -P 5037 nodaemon server
# ./scripts/docker-up.sh does this automatically.

RELAY_MODE=grpc
# Production (Docker image defaults — TLS chain baked at /app/certs/grpc-relay-ca.pem):
RELAY_SERVER=grpc-device-farm.tommadethis.app:443
RELAY_GRPC_TLS=true
# RELAY_GRPC_ROOT_CERT_FILE=/app/certs/grpc-relay-ca.pem  # baked in Docker image when TLS=true
# Local Docker + farm on host: RELAY_SERVER=host.docker.internal:50051  RELAY_GRPC_TLS=false  RELAY_GRPC_ROOT_CERT_FILE=
RELAY_API_KEY=change-me
RELAY_ENROLLMENT_TOKEN=dfra_change_me

# Relay-first keeps stream startup independent from slow U2/STF repair.
# Set legacy only for emergency rollback to the old bootstrap-before-relay flow.
AGENT_BOOT_STARTUP_MODE=relay-first
# Optional strict legacy behavior: fail container startup if ADB is unavailable.
AGENT_BOOT_REQUIRE_ADB_AT_START=0

# Docker image default: 1 — bootstrap (install APKs + atx + u2) when a device comes online.
# AGENT_BOOT_AUTO_BOOTSTRAP=1
# Bound heavy repair work so a 20-phone agent keeps ADB/stream capacity available.
RELAY_BOOTSTRAP_CONCURRENCY=2
# Viewer-triggered scrcpy uses the startup lane. Background auto-bootstrap
# waits a deterministic 8-16 second spread and stays deferred while viewed.
RELAY_AUTO_BOOTSTRAP_DELAY_SECONDS=8
RELAY_AUTO_BOOTSTRAP_DEFER_WHILE_SCRCPY=1
AGENT_BOOT_FORCE_U2_INSTALL=0

# One ADB server multiplexes all connected phones. Runtime clamps legacy/high
# overrides to adb/u2 pools<=24, scrcpy pool<=4, adb commands<=24 and heavy<=4
# to avoid ADB push/forward storms.
RELAY_ADB_POOL_SIZE=12
RELAY_U2_POOL_SIZE=12
RELAY_SCRCPY_POOL_SIZE=3
RELAY_ADB_COMMAND_CONCURRENCY=12
RELAY_ADB_INTERACTIVE_RESERVED=2
RELAY_ADB_HEAVY_CONCURRENCY=3

AGENT_BOOT_EXTRA_ENABLED=0

AGENT_BOOT_XML_MAX_BYTES=8388608
AGENT_BOOT_XML_PARSE_WORKERS=4

AGENT_BOOT_CONTENT_DB_ENABLED=1
AGENT_BOOT_CONTENT_DATABASE_URL=postgresql://postgres:flo5X1M38132Dy@100.117.108.83/device_farm
AGENT_BOOT_CONTENT_DB_POOL_SIZE=2
AGENT_BOOT_CONTENT_DB_COMMAND_TIMEOUT=10

# Parsed content + inline hierarchy in DB. Screenshot base64 is expensive and
# can exceed gRPC payload limits on high-resolution devices; opt in when needed.
# AGENT_BOOT_CAPTURE_SCREENSHOT=0

SCRCPY_VIDEO_CODEC=h264
SCRCPY_HEVC_OEM_ALLOWLIST=
SCRCPY_SERVER_JAR_VERIFY_TTL_SECONDS=300
# SCRCPY_VIDEO_ENCODER__<serial>=...  # optional; vivo Android 16: leave unset (auto)
SCRCPY_H264_BASELINE=false
AGENT_BOOT_LOCK_ROTATION=1
AGENT_BOOT_LOCK_ROTATION_AFTER_SHELL=1

# Reliable command results may absorb short bursts, while video must remain
# shallow so every live phone sends current frames instead of stale backlog.
RELAY_SEND_PER_DEVICE_MAX=16
RELAY_SEND_VIDEO_PER_DEVICE_MAX=2
# 0 = no artificial session cap; set a measured per-agent ceiling if needed.
SCRCPY_MAX_SESSIONS=0

# Save hierarchy XML when post-open tap fails (agent-boot/debug/traces/)
# OPEN_POST_DEBUG_DUMP=1
