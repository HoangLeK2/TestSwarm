# Agent-boot — relay + WebRTC media adapter.
#
# Docker + USB on host: ADB server must listen globally (not localhost-only):
#   adb kill-server && adb -a -P 5037 nodaemon server
# ./scripts/docker-up.sh does this automatically.

RELAY_MODE=grpc
# Local root docker-compose stack. For production, set RELAY_SERVER to the public
# relay endpoint and RELAY_GRPC_TLS=true with the deployed root CA.
RELAY_SERVER=127.0.0.1:50051
RELAY_GRPC_TLS=false
RELAY_GRPC_ROOT_CERT_FILE=
RELAY_API_KEY=change-me
RELAY_ENROLLMENT_TOKEN=dfra_change_me

# WebRTC publishing. This Go adapter runs local-side with agent-boot, close to
# ADB/USB/phones. Backend talks to it over HTTP; backend does not own media.
MEDIA_ADAPTER_ENABLED=1
MEDIA_ADAPTER_RTSP_ADDRESS=:8556
# Docker starts the reusable Go media adapter in the same image/container.
# Future sidecar split only needs MEDIA_ADAPTER_HTTP_HOST to point to that service.
MEDIA_ADAPTER_AUTOSTART=1
MEDIA_ADAPTER_HTTP_HOST=127.0.0.1
MEDIA_ADAPTER_HTTP_BIND=0.0.0.0
MEDIA_ADAPTER_HTTP_PORT=8878
MEDIA_ADAPTER_GO2RTC_URL=http://host.docker.internal:1984
MEDIA_ADAPTER_GO2RTC_RTSP_SOURCE_TEMPLATE=rtsp://host.docker.internal:8556/{stream_raw}
# Keep queue shallow. When go2rtc/readers stall, stale P-frames are dropped
# instead of building latency across many phones.
MEDIA_ADAPTER_QUEUE_MAX=8
MEDIA_ADAPTER_STALE_PACKET_MS=160
MEDIA_ADAPTER_RTSP_WRITE_QUEUE=128
MEDIA_ADAPTER_INPUT_FPS=15
# Opt in when the Go adapter should own scrcpy video/control-video sockets.
# U2 remains the user input path.
MEDIA_ADAPTER_DIRECT_SCRCPY_ENABLED=1
# Production media owner mode: Go adapter launches/stops scrcpy-server and owns
# reconnect/keyframe/RTSP publishing. Python only sends stream start/stop intent.
MEDIA_ADAPTER_OWNS_SCRCPY=1
MEDIA_ADAPTER_SCRCPY_SERVER_PATH=/app/media-adapter/assets/scrcpy-server
MEDIA_ADAPTER_SCRCPY_SERVER_VERSION=4.1

# Relay-first keeps stream startup independent from slow U2/STF repair.
# Set legacy only for emergency rollback to the old bootstrap-before-relay flow.
AGENT_BOOT_STARTUP_MODE=relay-first
# Optional strict legacy behavior: fail container startup if ADB is unavailable.
AGENT_BOOT_REQUIRE_ADB_AT_START=0

# Discovery-only. Backend/user registration sends explicit bootstrap before
# APKs/atx/u2 assets are pushed to a phone.
AGENT_BOOT_AUTO_BOOTSTRAP=0
# Bound heavy repair work so a 20-phone agent keeps ADB/stream capacity available.
RELAY_BOOTSTRAP_CONCURRENCY=2
RELAY_RECOVERY_CONCURRENCY=8
RELAY_RECOVERY_BREAKER_FAILURES=3
RELAY_RECOVERY_BREAKER_BASE_S=5
RELAY_RECOVERY_BREAKER_MAX_S=60
# Legacy fallback only if auto-bootstrap is explicitly re-enabled for a lab.
RELAY_AUTO_BOOTSTRAP_DELAY_SECONDS=8
RELAY_AUTO_BOOTSTRAP_DEFER_WHILE_SCRCPY=1
AGENT_BOOT_FORCE_U2_INSTALL=0

# One ADB server multiplexes all connected phones. Executor pools are headroom
# for bursty subprocess work; RELAY_ADB_COMMAND_CONCURRENCY and
# RELAY_ADB_HEAVY_CONCURRENCY are the real pressure controls.
RELAY_ADB_POOL_SIZE=48
RELAY_U2_POOL_SIZE=48
RELAY_SCRCPY_POOL_SIZE=96
RELAY_ADB_COMMAND_CONCURRENCY=24
RELAY_ADB_INTERACTIVE_RESERVED=4
RELAY_ADB_STARTUP_RESERVED=2
RELAY_ADB_HEAVY_CONCURRENCY=4
ADB_CONNECT_RETRY_BASE_S=2
ADB_CONNECT_RETRY_MAX_S=30

# U2 session pool: keep foreground requests fast without letting background
# heartbeat/reconnect churn hit every phone at once.
U2_BATCH_ENABLED=true
U2_SESSION_TTL_SECONDS=300
U2_KEEP_WARM_TTL_SECONDS=120
U2_KEEP_WARM_MAX_SESSIONS=12
U2_HEARTBEAT_INTERVAL_SECONDS=10
U2_HEARTBEAT_MAX_PROBES_PER_TICK=8
U2_HEARTBEAT_SKIP_RECENT_SECONDS=45
AGENT_BOOT_U2_WARM_ON_HEARTBEAT=false
AGENT_BOOT_U2_FORWARD_CREATE_CONCURRENCY=8
U2_EXECUTOR_CONCURRENCY=64
U2_EXECUTOR_VISIBLE_RESERVED=8
U2_EXECUTOR_BACKGROUND_CONCURRENCY=56
U2_HIERARCHY_SINGLEFLIGHT_ENABLED=true
U2_XML_BATCH_OPTIMIZER_ENABLED=true
U2_HTTP_DIRECT_TOUCH_ENABLED=true
U2_HTTP_WAIT_VISIBLE_POLL_S=0.10
U2_HTTP_WAIT_BACKGROUND_POLL_S=0.25
U2_HIERARCHY_CACHE_TTL_MS=120
U2_VISIBLE_HIERARCHY_CACHE_TTL_MS=80
U2_BREAKER_FAILURES=3
U2_BREAKER_BASE_S=2
U2_BREAKER_MAX_S=30

# Optional content writer. Leave disabled for stream-only local runs.
AGENT_BOOT_CONTENT_DB_ENABLED=0
# AGENT_BOOT_CONTENT_DATABASE_URL=

SCRCPY_VIDEO_CODEC=h264
SCRCPY_HEVC_OEM_ALLOWLIST=
SCRCPY_SERVER_JAR_VERIFY_TTL_SECONDS=300
SCRCPY_H264_BASELINE=false
AGENT_BOOT_LOCK_ROTATION=1
AGENT_BOOT_LOCK_ROTATION_AFTER_SHELL=1

# Reliable command results may absorb short bursts. Video is owned by the Go
# media adapter and is not sent through agent-boot queues.
RELAY_SEND_PER_DEVICE_MAX=16
# Local guardrail for weak hosts: visible sessions are never evicted, but idle
# warm sessions can be stopped by TTL/LRU when this cap is reached.
SCRCPY_MAX_SESSIONS=200
SCRCPY_WARM_IDLE_ENABLED=1
SCRCPY_WARM_IDLE_TTL_S=45
SCRCPY_PREVIEW_DETACH_GRACE_S=1
SCRCPY_DEFAULT_MAX_FPS=1
SCRCPY_DEFAULT_MAX_WIDTH=320
SCRCPY_DEFAULT_BITRATE=150000
SCRCPY_VISIBLE_MAX_FPS=1
SCRCPY_VISIBLE_MAX_WIDTH=320
SCRCPY_VISIBLE_BITRATE=150000
SCRCPY_FOCUSED_MAX_FPS=15
SCRCPY_FOCUSED_MAX_WIDTH=600
SCRCPY_FOCUSED_BITRATE=900000
SCRCPY_DEGRADED_MAX_FPS=1
SCRCPY_DEGRADED_MAX_WIDTH=320
SCRCPY_DEGRADED_BITRATE=150000
SCRCPY_CAPTURE_RESET_STORM_MAX=8
SCRCPY_ENCODER_DEGRADE_TTL_S=60

# Save hierarchy XML when post-open tap fails (agent-boot/debug/traces/)
# OPEN_POST_DEBUG_DUMP=1
