# Customer agent-boot configuration.
# Copy this file to .env, then fill every REQUIRED value before start.

# ── REQUIRED: customer-specific credentials ──────────────────────────────────
RELAY_API_KEY=
RELAY_ENROLLMENT_TOKEN=
AGENT_BOOT_CONTENT_DATABASE_URL=

# ── Relay connection ─────────────────────────────────────────────────────────
RELAY_MODE=grpc
RELAY_SERVER=grpc-device-farm.tommadethis.app:443
RELAY_GRPC_TLS=true
RELAY_GRPC_ROOT_CERT_FILE=/app/certs/grpc-relay-ca.pem
# Leave empty to create and persist a stable relay ID automatically.
RELAY_ID=

# ── Windows host ADB / startup ────────────────────────────────────────────────
ADB_HOST=host.docker.internal
ADB_PORT=5037
# Optional: comma-separated ADB daemons when devices are split across ports.
# Example: tcp:host.docker.internal:5037,tcp:host.docker.internal:5038
ADB_SERVER_SOCKETS=
ADB_WAIT_SECONDS=120
AGENT_BOOT_STARTUP_MODE=relay-first
AGENT_BOOT_REQUIRE_ADB_AT_START=0
AGENT_BOOT_AUTO_BOOTSTRAP=0
RELAY_BOOTSTRAP_CONCURRENCY=2
RELAY_RECOVERY_CONCURRENCY=8
RELAY_RECOVERY_BREAKER_FAILURES=3
RELAY_RECOVERY_BREAKER_BASE_S=5
RELAY_RECOVERY_BREAKER_MAX_S=60
# Discovery is lightweight. Backend/user registration sends explicit bootstrap
# before u2/STF/atx assets are pushed to a phone.
RELAY_AUTO_BOOTSTRAP_DELAY_SECONDS=8
RELAY_AUTO_BOOTSTRAP_DEFER_WHILE_SCRCPY=1
AGENT_BOOT_FORCE_U2_INSTALL=0
AGENT_BOOT_MDNS=0

# ── Content extraction and PostgreSQL writer ─────────────────────────────────
AGENT_BOOT_CONTENT_DB_ENABLED=1
AGENT_BOOT_CONTENT_DB_POOL_SIZE=8
AGENT_BOOT_CONTENT_DB_COMMAND_TIMEOUT=10
AGENT_BOOT_CONTENT_DB_RETRIES=3
AGENT_BOOT_CONTENT_DB_RETRY_BASE_DELAY=0.2
# Screenshot base64 is expensive and can exceed gRPC payload limits on some
# devices. Enable only for workflows that explicitly need image evidence.
AGENT_BOOT_CAPTURE_SCREENSHOT=0
AGENT_BOOT_EXTRA_ENABLED=0
AGENT_BOOT_XML_MAX_BYTES=8388608
AGENT_BOOT_XML_PARSE_WORKERS=8

# ── Capacity defaults for a multi-phone relay ────────────────────────────────
# Executor pools provide headroom; admission limits protect the shared host ADB
# server from push/install/bootstrap storms.
RELAY_ADB_POOL_SIZE=48
RELAY_U2_POOL_SIZE=48
RELAY_SCRCPY_POOL_SIZE=96
RELAY_ADB_COMMAND_CONCURRENCY=24
RELAY_ADB_INTERACTIVE_RESERVED=4
RELAY_ADB_STARTUP_RESERVED=2
RELAY_ADB_HEAVY_CONCURRENCY=4
ADB_CONNECT_RETRY_BASE_S=2
ADB_CONNECT_RETRY_MAX_S=30
RELAY_GENERIC_POOL_SIZE=8
RELAY_CPU_POOL_SIZE=8
RELAY_EXTRA_DATA_CONCURRENCY=64
RELAY_U2_BATCH_CONCURRENCY=64
RELAY_U2_FLOW_CONCURRENCY=64
U2_BATCH_ENABLED=true
AGENT_BOOT_U2_WARM_ON_HEARTBEAT=false
U2_SESSION_TTL_SECONDS=300
U2_KEEP_WARM_TTL_SECONDS=120
U2_KEEP_WARM_MAX_SESSIONS=12
U2_HEARTBEAT_INTERVAL_SECONDS=10
U2_HEARTBEAT_MAX_PROBES_PER_TICK=8
U2_HEARTBEAT_SKIP_RECENT_SECONDS=45
U2_HEARTBEAT_RECONNECT_RECENT=false
U2_PREPARE_SKIP_ALIVE_SECONDS=12
AGENT_BOOT_U2_FORWARD_CREATE_CONCURRENCY=8
U2_EXECUTOR_CONCURRENCY=64
U2_EXECUTOR_VISIBLE_RESERVED=8
U2_EXECUTOR_BACKGROUND_CONCURRENCY=56
U2_COMMAND_DEADLINE_MS=0
U2_HIERARCHY_SINGLEFLIGHT_ENABLED=true
U2_XML_BATCH_OPTIMIZER_ENABLED=true
U2_HTTP_DIRECT_TOUCH_ENABLED=true
U2_HTTP_EXISTS_RPC_ENABLED=true
U2_HTTP_WAIT_POLL_ENABLED=true
U2_HTTP_WAIT_VISIBLE_POLL_S=0.10
U2_HTTP_WAIT_BACKGROUND_POLL_S=0.25
U2_HTTP_WAIT_TIMEOUT_CAP_S=5.0
U2_HIERARCHY_CACHE_TTL_MS=120
U2_VISIBLE_HIERARCHY_CACHE_TTL_MS=80
U2_BREAKER_FAILURES=3
U2_BREAKER_BASE_S=2
U2_BREAKER_MAX_S=30

# ── Video/control defaults ────────────────────────────────────────────────────
MEDIA_ADAPTER_ENABLED=1
# Docker Compose production uses the same image for two containers:
# agent-boot (control/u2/gRPC) and media-adapter (scrcpy/WebRTC media).
# Keep autostart off so logs/restarts stay separated. Only set this to 1 for
# single-container/manual rollback runs.
MEDIA_ADAPTER_AUTOSTART=0
MEDIA_ADAPTER_DIRECT_SCRCPY_ENABLED=1
MEDIA_ADAPTER_HTTP_BIND=0.0.0.0
MEDIA_ADAPTER_HTTP_PORT=8878
# Local adapter opens this outbound gRPC stream to the cloud backend. Backend
# sends only media control commands here; H264 bytes do not traverse gRPC.
MEDIA_ADAPTER_CONTROL_GRPC_ENABLED=1
MEDIA_ADAPTER_CONTROL_GRPC_SERVER=grpc-device-farm.tommadethis.app:443
MEDIA_ADAPTER_CONTROL_GRPC_TLS=true
MEDIA_ADAPTER_CONTROL_GRPC_ROOT_CERT_FILE=/app/certs/grpc-relay-ca.pem
MEDIA_ADAPTER_CONTROL_HEARTBEAT_SECONDS=5
MEDIA_ADAPTER_ID=
# Cloud go2rtc endpoints reachable from this local machine. RTSP publish is the
# hot media path: local adapter -> cloud go2rtc. Use STUN/ICE only; no TURN.
MEDIA_ADAPTER_GO2RTC_URL=https://go2rtc.example.com
MEDIA_ADAPTER_GO2RTC_RTSP_SOURCE_TEMPLATE=rtsp://go2rtc.example.com:8554/{stream_raw}
MEDIA_ADAPTER_GO2RTC_RTSP_PUBLISH_TEMPLATE=rtsp://go2rtc.example.com:8554/{stream_raw}
MEDIA_ADAPTER_GO2RTC_REGISTER_ENABLED=1
MEDIA_ADAPTER_QUEUE_MAX=8
MEDIA_ADAPTER_STALE_PACKET_MS=160
MEDIA_ADAPTER_RTSP_WRITE_QUEUE=128
MEDIA_ADAPTER_REMOTE_RTSP_QUEUE=256
MEDIA_ADAPTER_REMOTE_RTSP_TIMEOUT_MS=1500
MEDIA_ADAPTER_INPUT_FPS=15
MEDIA_ADAPTER_OWNS_SCRCPY=1
MEDIA_ADAPTER_SCRCPY_SERVER_PATH=/app/media-adapter/assets/scrcpy-server
MEDIA_ADAPTER_SCRCPY_SERVER_VERSION=4.1

SCRCPY_AUTO_RESUME=false
SCRCPY_VIDEO_CODEC=h264
SCRCPY_HEVC_OEM_ALLOWLIST=
SCRCPY_CRASH_SAFE_CODEC_OPTIONS=1
SCRCPY_AUTO_SOFTWARE_ENCODER_FALLBACK=1
SCRCPY_SERVER_JAR_VERIFY_TTL_SECONDS=300
SCRCPY_H264_BASELINE=false
SCRCPY_CLEANUP=false
SCRCPY_DEFAULT_MAX_FPS=1
SCRCPY_DEFAULT_MAX_WIDTH=320
SCRCPY_DEFAULT_BITRATE=150000
SCRCPY_VISIBLE_MAX_FPS=1
SCRCPY_VISIBLE_MAX_WIDTH=320
SCRCPY_VISIBLE_BITRATE=150000
SCRCPY_FOCUSED_MAX_FPS=15
SCRCPY_FOCUSED_MAX_WIDTH=600
SCRCPY_FOCUSED_BITRATE=900000
SCRCPY_DEGRADED_MAX_FPS=1
SCRCPY_DEGRADED_MAX_WIDTH=320
SCRCPY_DEGRADED_BITRATE=150000
SCRCPY_CAPTURE_RESET_STORM_MAX=8
SCRCPY_ENCODER_DEGRADE_TTL_S=60
RELAY_SEND_PER_DEVICE_MAX=16
RELAY_GRPC_MAX_MESSAGE_BYTES=4194304
SCRCPY_MAX_SESSIONS=200
SCRCPY_WARM_IDLE_ENABLED=1
SCRCPY_WARM_IDLE_TTL_S=45
SCRCPY_PREVIEW_DETACH_GRACE_S=1
SCRCPY_GOP_CACHE_MAX_BYTES=2097152
SCRCPY_GOP_CACHE_MAX_FRAMES=90
AGENT_BOOT_LOCK_ROTATION=1
AGENT_BOOT_LOCK_ROTATION_AFTER_SHELL=1
