# Customer agent-boot configuration.
# Copy this file to .env, then fill every REQUIRED value before start.

# ── REQUIRED: customer-specific credentials ──────────────────────────────────
RELAY_API_KEY=
RELAY_ENROLLMENT_TOKEN=

# ── Relay connection ─────────────────────────────────────────────────────────
RELAY_MODE=grpc
RELAY_SERVER=grpc-device-farm.tommadethis.app:443
RELAY_GRPC_TLS=true
RELAY_GRPC_ROOT_CERT_FILE=/app/certs/grpc-relay-ca.pem
# The relay ID is issued by the server on first register and persisted in
# ./state — it is not configurable here. Name the machine in the admin console.

# ── Windows host ADB / startup ────────────────────────────────────────────────
ADB_HOST=host.docker.internal
ADB_PORT=5037
# Optional: comma-separated ADB daemons when devices are split across ports.
# Example: tcp:host.docker.internal:5037,tcp:host.docker.internal:5038
ADB_SERVER_SOCKETS=
ADB_WAIT_SECONDS=120
AGENT_BOOT_STARTUP_MODE=relay-first
AGENT_BOOT_REQUIRE_ADB_AT_START=0
AGENT_BOOT_AUTO_BOOTSTRAP=0
RELAY_BOOTSTRAP_CONCURRENCY=2
RELAY_RECOVERY_CONCURRENCY=8
RELAY_RECOVERY_BREAKER_FAILURES=3
RELAY_RECOVERY_BREAKER_BASE_S=5
RELAY_RECOVERY_BREAKER_MAX_S=60
# Discovery is lightweight. Backend/user registration sends explicit bootstrap
# before u2/STF/atx assets are pushed to a phone.
RELAY_AUTO_BOOTSTRAP_DELAY_SECONDS=8
RELAY_AUTO_BOOTSTRAP_DEFER_WHILE_SCRCPY=1
AGENT_BOOT_FORCE_U2_INSTALL=0
AGENT_BOOT_MDNS=0

# ── Content extraction uplink ────────────────────────────────────────────────
# Content rows travel back inside the relay reply; device_farm resolves the
# tenant and writes PostgreSQL. This host never holds a database credential.
AGENT_BOOT_CONTENT_UPLINK_CHUNK_BYTES=524288
# Screenshot base64 is expensive and can exceed gRPC payload limits on some
# devices. Enable only for workflows that explicitly need image evidence.
AGENT_BOOT_CAPTURE_SCREENSHOT=0
AGENT_BOOT_EXTRA_ENABLED=0
AGENT_BOOT_XML_MAX_BYTES=8388608
AGENT_BOOT_XML_PARSE_WORKERS=8

# ── Capacity defaults for a multi-phone relay ────────────────────────────────
# Executor pools provide headroom; admission limits protect the shared host ADB
# server from push/install/bootstrap storms.
RELAY_ADB_POOL_SIZE=48
RELAY_U2_POOL_SIZE=48
RELAY_SCRCPY_POOL_SIZE=96
RELAY_ADB_COMMAND_CONCURRENCY=24
RELAY_ADB_INTERACTIVE_RESERVED=4
RELAY_ADB_STARTUP_RESERVED=2
RELAY_ADB_HEAVY_CONCURRENCY=4
ADB_CONNECT_RETRY_BASE_S=2
ADB_CONNECT_RETRY_MAX_S=30
RELAY_GENERIC_POOL_SIZE=8
RELAY_CPU_POOL_SIZE=8
RELAY_EXTRA_DATA_CONCURRENCY=64
RELAY_U2_BATCH_CONCURRENCY=64
RELAY_U2_FLOW_CONCURRENCY=64
U2_BATCH_ENABLED=true
AGENT_BOOT_U2_WARM_ON_HEARTBEAT=false
U2_SESSION_TTL_SECONDS=300
U2_KEEP_WARM_TTL_SECONDS=120
U2_KEEP_WARM_MAX_SESSIONS=12
U2_HEARTBEAT_INTERVAL_SECONDS=10
U2_HEARTBEAT_MAX_PROBES_PER_TICK=8
U2_HEARTBEAT_SKIP_RECENT_SECONDS=45
U2_HEARTBEAT_RECONNECT_RECENT=false
U2_PREPARE_SKIP_ALIVE_SECONDS=12
AGENT_BOOT_U2_FORWARD_CREATE_CONCURRENCY=8
U2_EXECUTOR_CONCURRENCY=64
U2_EXECUTOR_VISIBLE_RESERVED=8
U2_EXECUTOR_BACKGROUND_CONCURRENCY=56
U2_COMMAND_DEADLINE_MS=0
U2_HIERARCHY_SINGLEFLIGHT_ENABLED=true
U2_XML_BATCH_OPTIMIZER_ENABLED=true
U2_HTTP_DIRECT_TOUCH_ENABLED=true
U2_HTTP_EXISTS_RPC_ENABLED=true
U2_HTTP_WAIT_POLL_ENABLED=true
U2_HTTP_WAIT_VISIBLE_POLL_S=0.10
U2_HTTP_WAIT_BACKGROUND_POLL_S=0.25
U2_HTTP_WAIT_TIMEOUT_CAP_S=5.0
U2_HIERARCHY_CACHE_TTL_MS=120
U2_VISIBLE_HIERARCHY_CACHE_TTL_MS=80
U2_BREAKER_FAILURES=3
U2_BREAKER_BASE_S=2
U2_BREAKER_MAX_S=30

# ── Video/control defaults ────────────────────────────────────────────────────
MEDIA_ADAPTER_ENABLED=1
# Docker Compose production uses the same image for two containers:
# agent-boot (control/u2/gRPC) and media-adapter (scrcpy/WebRTC media).
# Keep autostart off so logs/restarts stay separated. Only set this to 1 for
# single-container/manual rollback runs.
MEDIA_ADAPTER_AUTOSTART=0
MEDIA_ADAPTER_DIRECT_SCRCPY_ENABLED=1
MEDIA_ADAPTER_HTTP_HOST=127.0.0.1
MEDIA_ADAPTER_HTTP_BIND=0.0.0.0
MEDIA_ADAPTER_HTTP_PORT=8878
# Local adapter opens this outbound gRPC stream to the cloud backend. Backend
# sends only media control commands here; H264 bytes do not traverse gRPC.
MEDIA_ADAPTER_CONTROL_GRPC_ENABLED=1
MEDIA_ADAPTER_CONTROL_GRPC_SERVER=grpc-device-farm.tommadethis.app:443
MEDIA_ADAPTER_CONTROL_GRPC_TLS=true
MEDIA_ADAPTER_CONTROL_GRPC_ROOT_CERT_FILE=/app/certs/grpc-relay-ca.pem
MEDIA_ADAPTER_CONTROL_HEARTBEAT_SECONDS=5
MEDIA_ADAPTER_ID=
# Cloud go2rtc, reached from this local machine. RTSP publish is the hot media
# path: local adapter -> cloud go2rtc. Outbound only, so NAT here is fine; the
# server never dials back in. Use STUN/ICE only; no TURN.
#
# USER/PASS must match RTSP_USER/RTSP_PASS on the server. :8554 is exposed to
# the internet — without credentials anyone could ANNOUNCE over a device's
# stream name and viewers would be served their video instead.
# Host phải là địa chỉ ORIGIN của server. Không dùng tên đã bật proxy Cloudflare
# (device-farm.tommadethis.app -> 104.21.x.x): Cloudflare chỉ proxy HTTP/HTTPS
# trên port chuẩn, không forward RTSP 8554, nên adapter sẽ bắt tay với Cloudflare
# và không bao giờ tới được go2rtc.
MEDIA_ADAPTER_GO2RTC_RTSP_PUBLISH_TEMPLATE=rtsp://farm:PASTE_RTSP_PASS_HERE@grpc-device-farm.tommadethis.app:8554/{stream_raw}
#
# WHIP alternative (opt-in). Point this at go2rtc's WebRTC ingest instead and the
# adapter publishes over WebRTC — the transport is chosen by the URL scheme, so
# there is no second switch to keep in sync:
#
#   MEDIA_ADAPTER_GO2RTC_RTSP_PUBLISH_TEMPLATE=https://farm:PASTE_WHIP_PASS_HERE@whip-device-farm.tommadethis.app/api/webrtc?dst={stream_raw}
#
# Through a reverse proxy, NOT go2rtc:1984 directly. :1984 stays `ufw deny` on
# the server because it is the admin API — PUT /api/streams rewrites config — and
# WHIP ingest happens to live on the same port. The proxy must allow POST
# /api/webrtc and nothing else, behind Basic auth. Credentials go in the URL
# userinfo; Go's net/http turns them into the Authorization header itself.
# Cloudflare proxying is fine on this hostname, unlike the rtsp:// line above:
# signalling is one small HTTPS POST and the media still goes UDP to :8555.
#
# What it buys: go2rtc negotiates nack, so packets lost on the uplink are
# RETRANSMITTED instead of leaving the picture broken until the next keyframe.
# Over RTSP there is no such channel — the receiver cannot even report the loss,
# which is the root cause of a stream that freezes until the viewer refreshes.
#
# What it costs: RTSP publishing is one outbound TCP connection and therefore
# survives any NAT. WHIP needs UDP to go2rtc's media port plus STUN, so a
# customer network that blocks UDP loses the stream ENTIRELY. Try it on one
# machine before a fleet, and keep the rtsp:// line above to fall back to.
MEDIA_ADAPTER_WHIP_ICE_SERVERS=stun:stun.l.google.com:19302
MEDIA_ADAPTER_WHIP_TIMEOUT_MS=5000
MEDIA_ADAPTER_WHIP_REDIAL_MS=2000
# Keep 0. With publishing on, RegisterStream would PUT a *pull* src into go2rtc
# pointing back at this machine's :8556 — unreachable across NAT, and competing
# with the publisher for the same stream name.
MEDIA_ADAPTER_GO2RTC_REGISTER_ENABLED=0
# Unused while REGISTER_ENABLED=0; the backend does WebRTC signaling itself
# (MEDIA_WEBRTC_SIGNALING_PLANE=backend), so this machine never calls :1984.
# MEDIA_ADAPTER_GO2RTC_URL=
# MEDIA_ADAPTER_GO2RTC_RTSP_SOURCE_TEMPLATE=
# Đổi thành `debug` khi một máy không lên hình, rồi restart và gửi log
# media-adapter. Ở mức info, lỗi thật của máy (encoder từ chối, scrcpy-server
# chết) bị bỏ đi và chỉ còn "handshake not ready ... EOF".
MEDIA_ADAPTER_LOG_LEVEL=info
# Đặt 1 nếu một máy không phải Note 10+ cũng không lên hình. scrcpy 4.x tự ép
# độ phân giải/fps theo khả năng mà encoder khai báo; encoder khai báo sai thì
# chính bước đó làm chết stream. Note 10+ đã tự bật sẵn theo model.
MEDIA_ADAPTER_SCRCPY_IGNORE_ENCODER_CONSTRAINTS=0
# Đặt 0 để Note 10+ chạy y hệt mọi máy khác (bỏ ép encoder + bỏ hạ 480p/15fps).
# Dùng để kiểm chứng xem chính profile riêng đó mới là nguyên nhân.
MEDIA_ADAPTER_SCRCPY_DEVICE_SAFE_PROFILE=1
# Để trống. Chỉ điền tên encoder đã xác nhận có trên máy bằng list_encoders=true.
# Ép một tên chưa kiểm chứng chính là thứ làm Note 10+ treo.
MEDIA_ADAPTER_SCRCPY_SAFE_VIDEO_ENCODER=
# 0 = máy Note 10+ encode ở độ phân giải gốc. Mọi giá trị thu nhỏ đều làm
# encoder Exynos abort, nên chỉ đổi khi đã xác nhận một cỡ chạy được trên máy.
MEDIA_ADAPTER_SCRCPY_SAFE_MAX_SIZE=0
# 0 = không giới hạn fps cho máy Note 10+. max_fps thành key vendor
# max-fps-to-encoder, và riêng nó cũng đủ làm encoder Exynos abort.
MEDIA_ADAPTER_SCRCPY_SAFE_MAX_FPS=0
# Thu nhỏ chính màn hình máy thay vì bắt encoder scale. Ví dụ: 720x1480.
# Để trống = không đụng tới máy. Đây là thay đổi THẬT và lưu lại trên điện thoại:
# app hiển thị khác, automation theo toạ độ tuyệt đối sẽ lệch.
# Hoàn tác: adb -s <serial> shell wm size reset && wm density reset
MEDIA_ADAPTER_SCRCPY_SAFE_DISPLAY_SIZE=
MEDIA_ADAPTER_QUEUE_MAX=8
# 1000, not the 160 this used to be: 160ms is under three frames at 15fps, so an
# ordinary GC or scheduler hiccup was enough to break the reference chain on a
# device with nothing wrong with it. The latency it bought back was never
# observable — the browser's jitter buffer holds more than that by itself.
MEDIA_ADAPTER_STALE_PACKET_MS=1000
MEDIA_ADAPTER_RTSP_WRITE_QUEUE=128
# Depth of the RTSP publish queue to the cloud, in RTP packets. It must hold one
# access unit: a keyframe packetises to ~85 packets, so the 32 this used to say
# discarded every keyframe, then asked the device for an IDR that arrived
# oversized and overflowed in turn — a self-sustaining drop loop that ran with
# the uplink perfectly healthy. The earlier worry about a deep queue adding
# permanent latency does not apply: on overflow the whole backlog is discarded
# and the stream resynchronises to now, so depth costs burst memory, not lag.
# Values below 256 are clamped by the adapter.
MEDIA_ADAPTER_REMOTE_RTSP_QUEUE=256
MEDIA_ADAPTER_REMOTE_RTSP_TIMEOUT_MS=5000
MEDIA_ADAPTER_INPUT_FPS=15
# Minimum spacing between keyframe requests per device. Not a tuning knob to
# lower casually: scrcpy's RESET_VIDEO is a full MediaCodec reconfigure, and
# MediaCodec.configure() is exactly where Samsung Exynos encoders abort.
MEDIA_ADAPTER_IDR_MIN_INTERVAL_MS=3000
# Retire a device's publish lane after this long with no packets, releasing its
# goroutine and queue.
MEDIA_ADAPTER_LANE_IDLE_S=120
MEDIA_ADAPTER_OWNS_SCRCPY=1
MEDIA_ADAPTER_SCRCPY_SERVER_PATH=/app/media-adapter/assets/scrcpy-server
MEDIA_ADAPTER_SCRCPY_SERVER_VERSION=4.1

SCRCPY_AUTO_RESUME=false
SCRCPY_VIDEO_CODEC=h264
SCRCPY_HEVC_OEM_ALLOWLIST=
SCRCPY_CRASH_SAFE_CODEC_OPTIONS=1
SCRCPY_AUTO_SOFTWARE_ENCODER_FALLBACK=1
SCRCPY_SERVER_JAR_VERIFY_TTL_SECONDS=300
SCRCPY_H264_BASELINE=false
SCRCPY_CLEANUP=false
SCRCPY_DEFAULT_MAX_FPS=1
SCRCPY_DEFAULT_MAX_WIDTH=320
SCRCPY_DEFAULT_BITRATE=150000
SCRCPY_VISIBLE_MAX_FPS=1
SCRCPY_VISIBLE_MAX_WIDTH=320
SCRCPY_VISIBLE_BITRATE=150000
SCRCPY_FOCUSED_MAX_FPS=15
SCRCPY_FOCUSED_MAX_WIDTH=600
SCRCPY_FOCUSED_BITRATE=900000
SCRCPY_DEGRADED_MAX_FPS=1
SCRCPY_DEGRADED_MAX_WIDTH=320
SCRCPY_DEGRADED_BITRATE=150000
SCRCPY_CAPTURE_RESET_STORM_MAX=8
SCRCPY_ENCODER_DEGRADE_TTL_S=60
RELAY_SEND_PER_DEVICE_MAX=16
RELAY_GRPC_MAX_MESSAGE_BYTES=4194304
SCRCPY_MAX_SESSIONS=200
SCRCPY_WARM_IDLE_ENABLED=1
SCRCPY_WARM_IDLE_TTL_S=45
SCRCPY_PREVIEW_DETACH_GRACE_S=1
SCRCPY_GOP_CACHE_MAX_BYTES=2097152
SCRCPY_GOP_CACHE_MAX_FRAMES=90
AGENT_BOOT_LOCK_ROTATION=1
AGENT_BOOT_LOCK_ROTATION_AFTER_SHELL=1
