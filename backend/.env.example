# ─── Device Farm backend ─────────────────────────────────────────────────────
# URL backend (main server, MCP server calls to this)
DEVICE_FARM_URL=http://localhost:8081

# MCP bearer token for device/session/campaign/content/account/scenario tools.
MCP_AUTH_TOKEN=
# Preview MCP guardrails.
# DEVICE_FARM_MCP_RATE_LIMIT=120/minute
# DEVICE_FARM_MCP_AUDIT_LOG_PATH=backend/mcp/mcp_audit_log.jsonl
# Dedicated, initially absent legacy-import path. Production uses PostgreSQL
# mcp_tokens and must not import a token file inherited from another checkout.
DEVICE_FARM_MCP_TOKEN_STORE=data/android_platform_tester_mcp_tokens.json

# RBAC policy cache. Casbin policies live in DB table casbin_rule; workers
# refresh their process-local cache after this TTL or when clear_rbac_cache()
# is called in tests/admin tooling.
# DEVICE_FARM_RBAC_POLICY_CACHE_TTL_SECONDS=30
# DEVICE_FARM_RBAC_ENFORCER_CACHE_SIZE=4096

# ─── Main / server ───────────────────────────────────────────────────────────
FARM_CONFIG=config.yaml
FARM_RELOAD=0
# Thư mục build SPA (Next/Vite dist). Để trống thì tự tìm front-end/dist
# FARM_FRONTEND_DIST=

# Tự chạy agent-boot khi start server (main.py). Tắt: 0 / false / no / off
FARM_AGENT_BOOT=1

# Thư mục log file (mặc định: logs). Trong Docker image dùng /app/logs (đã tạo sẵn).
# FARM_LOG_DIR=logs

# Ngrok (nếu bật)
NGROK_ENABLED=0
NGROK_AUTHTOKEN=

# ─── Temporal (core/config.py — khi dùng Temporal worker) ───────────────────
# TEMPORAL_SERVER_URL=
# TEMPORAL_NAMESPACE=
# TEMPORAL_TASK_QUEUE=

# ─── Dedicated Android Platform Tester database ─────────────────────────────
# Required when config.database.enabled=true. Generic DATABASE_URL and DB_*
# settings are deliberately ignored so this service cannot reuse Device Farm DB.
ANDROID_PLATFORM_TESTER_DATABASE_URL=postgresql://platform_tester:platform_tester@localhost:55434/android_platform_tester

# ─── Auth (JWT) ─────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-long-random-string
# JWT_ALGORITHM=HS256
ACCESS_EXPIRE_HOURS=1
REFRESH_EXPIRE_DAYS=30

# ── Organization invites (email) ────────────────────────────────────────────
# Public URL of the Next.js dashboard (used in invite links).
# DEVICE_FARM_FRONTEND_URL=http://localhost:3000
# ORG_INVITE_EXPIRE_DAYS=7
# SMTP (aiosmtplib). When SMTP_HOST is empty, invite links are logged only.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=1
# SMTP_USE_SSL=0

# Optional one-time migration seed for a global superadmin account.
# Set before running DB migrations/startup; leave unset to skip seeding.
# DEVICE_FARM_SUPERADMIN_EMAIL=root@example.com
# DEVICE_FARM_SUPERADMIN_PASSWORD=change-me-long-random-password
# DEVICE_FARM_SUPERADMIN_NAME=Super Admin

# Encryption of account data (common/crypto.py) — hex/base64 according to implementation
# Required in staging/production; missing or invalid keys reject credential writes/runtime use.
# ACCOUNT_ENCRYPTION_KEY=

# ACCOUNT_DAILY_USAGE_LIMIT=30
# ACCOUNT_COOLDOWN_MINUTES=120

# Optional app-agnostic account verification. Configure an Android package and
# a trusted resource id that uniquely exposes the active account identifier.
ACCOUNT_VERIFICATION_MODE=off
ACCOUNT_VERIFICATION_CONCURRENCY=8
ACCOUNT_VERIFICATION_TIMEOUT_SECONDS=6
PLATFORM_VERIFICATION_PACKAGE=
PLATFORM_VERIFICATION_RESOURCE_ID=

# DLQ operations: auto-dismiss pending errors for stale offline devices and alert when pending grows.
# DEVICE_FARM_DLQ_OFFLINE_DISMISS_MINUTES=5
# DEVICE_FARM_DLQ_ALERT_THRESHOLD=10
# DEVICE_FARM_DLQ_MAINTENANCE_INTERVAL_SECONDS=300

# ─── Account profile history (account_events) ────────────────────────────────
# Requires PostgreSQL (ANDROID_PLATFORM_TESTER_DATABASE_URL and database.enabled).
# ACCOUNT_HISTORY_ENABLED=true
# ACCOUNT_HISTORY_MAX_BATCH=100
# ACCOUNT_HISTORY_MAX_PENDING=1000

# ─── AI / Scenario (compile-scenario, LLM fallback) ───────────────────────────
# Backend generate scenario: "llm" (default) or "mcp" (call AI_MCP_URL)
SCENARIO_AI_BACKEND=llm
# URL AI MCP server (Node) khi compile-scenario ưu tiên gọi đây. Response phải có scenario.steps đúng schema: GET /api/scenario/schema
AI_MCP_URL=http://localhost:4000

# LLM: openai hoặc gemini
SCENARIO_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Gemini
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# AI Device Lab generation stays fail-closed unless the generated operations
# match this server-owned policy. Add actions/targets only after security review.
AI_DEVICE_LAB_GENERATION_TIMEOUT_SECONDS=35
AI_DEVICE_LAB_OPERATION_POLICY_VERSION=adl-operations-v1
AI_DEVICE_LAB_ALLOWED_ACTIONS=navigation.open
AI_DEVICE_LAB_ALLOWED_TARGETS=

# Billing remains unavailable until every commercial field and a provider
# adapter are configured. Checkout URLs must be HTTPS and hosts must match the
# exact allowlist; provider references and webhook payloads are never public.
AI_DEVICE_LAB_PAYMENT_PROVIDER=
AI_DEVICE_LAB_PRICE_MINOR=
AI_DEVICE_LAB_CURRENCY=
AI_DEVICE_LAB_PRICING_VERSION=
AI_DEVICE_LAB_BILLING_POLICY_VERSION=adl-billing-unconfigured-v1
AI_DEVICE_LAB_CHECKOUT_ALLOWED_HOSTS=
AI_DEVICE_LAB_CHECKOUT_RETURN_URL=
AI_DEVICE_LAB_CHECKOUT_CANCEL_URL=
AI_DEVICE_LAB_CHECKOUT_TIMEOUT_SECONDS=10
AI_DEVICE_LAB_CHECKOUT_CONCURRENCY=8
AI_DEVICE_LAB_PAYMENT_RECONCILIATION_INTERVAL_SECONDS=5
AI_DEVICE_LAB_REFUND_DISPATCH_INTERVAL_SECONDS=5
# Operational probes only run after adapters, immutable release identity and a
# signed target are registered by deployment configuration.
AI_DEVICE_LAB_BUILD_REF=
AI_DEVICE_LAB_SCHEMA_VERSION=
AI_DEVICE_LAB_OPERATIONAL_PROBE_INTERVAL_SECONDS=30
AI_DEVICE_LAB_FARM_DELIVERY_INTERVAL_SECONDS=1
AI_DEVICE_LAB_DEVICE_HEALTH_FRESHNESS_SECONDS=120

# OPENAI_VISION_MODEL=gpt-4o-mini
# GEMINI_VISION_MODEL=gemini-2.0-flash

SCENARIO_UI_XML_MAX_CHARS=20000
SCENARIO_UI_XML_MAX_CHARS_PER_SCREEN=15000
# Debug file path (scenario JSON) – optional
# SCENARIO_DEBUG_JSON_PATH=

# ─── Edge extra-data extraction (PA B: relay-only) ───────────────────────────
# device_farm sends relay command extra_data → agent-boot u2 dump + parse + DB.
# No APK WebSocket and no phone HTTP POST required for extract.
EDGE_EXTRA_DATA_ENABLED=1
EDGE_EXTRA_RELAY_ENABLED=1
EDGE_EXTRA_APPLY_GLOBALLY=0
EDGE_EXTRA_TIMEOUT_S=90
# Legacy HTTP ingest debug only (not used by PA B extract):
# EDGE_EXTRA_AGENT_URL=http://192.168.1.10:8765
# EDGE_EXTRA_AGENT_PUBLIC_URL=http://192.168.1.10:8765
# EDGE_EXTRA_AGENT_URL_ALLOWLIST=http://192.168.1.10:8765
# EDGE_EXTRA_TOKEN=change-me-extra-token

# ─── Scenario runtime debug (tasks/scenario_task.py) ─────────────────────────
# Enable step-by-step capture / auto debug: 1, true, yes
# CAPTURE_STEPS=0
# DEBUG_AUTO=0
# CAPTURE_PRE_STEP=0


# ─── Agent / device ──────────────────────────────────────────────────────────
# agent_local.py / agent_pc.py: WebSocket URL to device-agent
# DEVICE_FARM_WS=ws://localhost:8081/device-agent

# agent-boot relay (continuous scrcpy + ADB from PC có cắm điện thoại):
#   RELAY_SERVER phải trỏ tới cổng HTTP của farm (mặc định 8081), KHÔNG dùng :50051.
#   Ví dụ farm Docker trên máy này: RELAY_SERVER=localhost:8081
#   RELAY_API_KEY khớp với farm (config relay.api_key hoặc env RELAY_API_KEY).
# RELAY_SERVER=localhost:8081
# RELAY_API_KEY=
# RELAY_TLS_CERT_FILE=/path/to/server.crt
# RELAY_TLS_KEY_FILE=/path/to/server.key
# RELAY_ALLOW_INSECURE_GRPC=true

# ADB / scrcpy (adb_device_bootstrap, device_client)
# SCRCPY_JAR=
# SCRCPY_ADB_BIN=adb
# DISABLE_U2=

# Giảm băng thông stream (device_media.py + device_client module load)
# LOW_BW_MODE=0
# LOW_BW_FRAME_SKIP=10

# uiautomator2 keepalive (device_client) — default 5.0 giây
# U2_KEEPALIVE_INTERVAL=5.0

# Device-control fallback auth when database is disabled
# In production/staging, DEVICE_CONTROL_API_KEY is required if DB is disabled.
# DEVICE_CONTROL_API_KEY=change-me
# DEVICE_FARM_ENV=dev
# AGENT_AUTH_REQUIRED=0

# Campaign throughput: 100-phone runs should not be split into 50-device waves.
CAMPAIGN_RUNTIME_START_CONCURRENCY=100
CAMPAIGN_DISPATCH_FANOUT_CONCURRENCY=100

# Visual anchor (SSIM / template match) — limit CPU concurrency (core/env.py)
# DEVICE_FARM_CV_CONCURRENCY=4

# Self-healing selectors: thử selector thay thế khi selector gốc fail (core/env.py)
# Bật để tự động tìm resource-id / text / content-desc thay thế từ XML hierarchy
# DEVICE_FARM_HEALING_ENABLED=1

# ─── Object storage / Cloudflare R2 (config.yaml object_storage + env) ─────
# Endpoint không gồm scheme: <ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=device-farm
# R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
# R2_PUBLIC_URL_INCLUDE_BUCKET=0
# R2_SECURE=true
# R2_REGION=
# Legacy MinIO (vẫn được đọc nếu R2_* thiếu): MINIO_ENDPOINT, MINIO_ACCESS_KEY, MINIO_SECRET_KEY, MINIO_BUCKET, MINIO_PUBLIC_BASE_URL, MINIO_SECURE
