# Root .env — single source of truth for docker compose + farm container.
# Copy to `.env` and fill in. Compose reads this for variable substitution AND
# injects it into the `farm` container via env_file.

# ─── Database (external Postgres by default) ─────────────────────────────────
# On Docker Desktop (Mac/Windows), host.docker.internal → the host machine.
# On Linux, compose adds host-gateway, or use the host's LAN IP.
# To use in-compose Postgres: uncomment service in docker-compose.yml, set DB_HOST=postgres
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=device_farm
DB_USER=postgres
DB_PASSWORD=flo5X1M38132Dy
# Optional: full URL overrides DB_* pieces above.
# DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/device_farm

# ─── Auth (JWT) ──────────────────────────────────────────────────────────────
SECRET_KEY=75BycVGEyxyn0Ci1J2EFMJKCp3SRGKOBNU0dGrkET_cMNN5O8PJX0bbLiW-2xGP1
ACCESS_EXPIRE_HOURS=1
REFRESH_EXPIRE_DAYS=30
# JWT_ALGORITHM=HS256
# ACCOUNT_ENCRYPTION_KEY=
# ACCOUNT_DAILY_USAGE_LIMIT=30
# ACCOUNT_COOLDOWN_MINUTES=120

# ─── Server / main ───────────────────────────────────────────────────────────
FARM_CONFIG=config.yaml
FARM_RELOAD=0
FARM_AGENT_BOOT=0
# FARM_FRONTEND_DIST=

# ─── Host ports (docker publish) ─────────────────────────────────────────────
# Container internal ports KHÔNG đổi (farm=8081, frontend=3000). Chỉ đổi host port.
FARM_HOST_PORT=18081
FRONTEND_HOST_PORT=13000
RELAY_HOST_PORT=50051

# ─── Device Farm backend URL (cho MCP / agent tự gọi về) ────────────────────
DEVICE_FARM_URL=http://localhost:18081
DEVICE_FARM_MCP_TOKEN=
# MCP_AUTH_TOKEN=

# ─── Frontend (Next.js) ──────────────────────────────────────────────────────
# Biến NEXT_PUBLIC_* được bake vào bundle LÚC BUILD → browser dùng.
# Phải là URL truy cập được TỪ TRÌNH DUYỆT (host IP/domain), KHÔNG phải tên service docker.
# Base origin (KHÔNG có /api suffix). Client sẽ tự append /api — xem front-end/src/lib/farm-api.ts.
NEXT_PUBLIC_PRODUCT_API_URL=https://device-farm.tommadethis.app
NEXT_PUBLIC_DEVICE_FARM_WS_URL=wss://device-farm.tommadethis.app/ws
NEXT_PUBLIC_ENVIRONMENT=production
# Backend URL cho Next server-side rewrites/proxy (chạy trong container → dùng service name, KHÔNG phụ thuộc host port).
DEVICE_FARM_BACKEND_URL=http://farm:8081
# Stream low-bandwidth mode
LOW_BW_MODE=true
LOW_BW_FRAME_SKIP=2
# Sentry (tuỳ chọn)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DISABLED=1
# NEXT_PUBLIC_SENTRY_ORG=
# NEXT_PUBLIC_SENTRY_PROJECT=


# ─── Ngrok ───────────────────────────────────────────────────────────────────
NGROK_ENABLED=0
NGROK_AUTHTOKEN=

# ─── Temporal ────────────────────────────────────────────────────────────────
# TEMPORAL_SERVER_URL is set to `temporal:7233` by compose for the farm container.
# TEMPORAL_NAMESPACE=
# TEMPORAL_TASK_QUEUE=

# ─── Relay (gRPC) ────────────────────────────────────────────────────────────
RELAY_API_KEY=8pEwyMn7HeHncnpIqwH10jx7nmM9gizIh0PWWboJmUg
RELAY_PORT=50051
# RELAY_SERVER=localhost:8081  # chỉ cho agent-boot chạy ngoài compose

# ─── Redis (shared state cache) ──────────────────────────────────────────────
# Setting REDIS_URL auto-enables redis. Leave blank to run in-memory only.
# In compose: redis://redis:6379/0   (service name from docker-compose.yml)
# Outside compose: redis://localhost:6379/0
REDIS_URL=redis://host.docker.internal:6379/0
# REDIS_PREFIX=df:   # only via YAML `redis.prefix`; env override not wired
# Web UI: docker compose up redis-ui → http://localhost:${REDIS_UI_PORT:-5540}
# REDIS_UI_PORT=5540

# ─── AI / Scenario ───────────────────────────────────────────────────────────
SCENARIO_AI_BACKEND=openai   # hoặc gemini
AI_MCP_URL=http://localhost:4000
SCENARIO_AI_PROVIDER=openai
