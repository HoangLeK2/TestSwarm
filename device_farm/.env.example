# ─── Device Farm backend ─────────────────────────────────────────────────────
# URL backend (main server, MCP server gọi tới đây)
DEVICE_FARM_URL=http://localhost:8081

# JWT cho MCP khi gọi /api/campaigns (list, create, compile-scenario, …). Lấy từ POST /api/auth/login.
# Để trống thì chỉ df_run_campaign và các tool device/session dùng được.
DEVICE_FARM_MCP_TOKEN=
# Hoặc dùng tên này:
# MCP_AUTH_TOKEN=

# ─── Main / server ───────────────────────────────────────────────────────────
FARM_CONFIG=config.yaml
FARM_RELOAD=0

# Ngrok (nếu bật)
NGROK_ENABLED=0
NGROK_AUTHTOKEN=

# ─── Database (khi config.database.enabled = true) ───────────────────────────
# DATABASE_URL=postgresql://user:pass@host:5432/device_farm
# Hoặc từng biến:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=device_farm
# DB_USER=
# DB_PASSWORD=postgres

# ─── Auth (JWT) ─────────────────────────────────────────────────────────────
# Bắt buộc khi dùng login / Bearer / WS ?token=
SECRET_KEY=change-me-in-production-use-long-random-string
# Tuỳ chọn, mặc định HS256 (python-jose)
# JWT_ALGORITHM=HS256
ACCESS_EXPIRE_HOURS=1
REFRESH_EXPIRE_DAYS=30

# ─── AI / Scenario (compile-scenario, LLM fallback) ────────────────────────
# Backend sinh scenario: "llm" (mặc định) hoặc "mcp" (gọi AI_MCP_URL)
SCENARIO_AI_BACKEND=llm
# URL AI MCP server (Node) khi compile-scenario ưu tiên gọi đây. Response phải có scenario.steps đúng schema: GET /api/scenario/schema
AI_MCP_URL=http://localhost:4000

# LLM: openai hoặc gemini
SCENARIO_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Gemini
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Giới hạn XML gửi LLM (ký tự)
SCENARIO_UI_XML_MAX_CHARS=20000
SCENARIO_UI_XML_MAX_CHARS_PER_SCREEN=15000
# Đường dẫn file debug (scenario JSON) – tùy chọn
# SCENARIO_DEBUG_JSON_PATH=

# ─── Agent / device ──────────────────────────────────────────────────────────
# agent_local.py: WebSocket URL device-agent
# DEVICE_FARM_WS=ws://localhost:8081/device-agent

# ADB / scrcpy (adb_device_bootstrap)
# FORCE_MINITOUCH=0
# SCRCPY_JAR=
# SCRCPY_ADB_BIN=adb
# DISABLE_U2=0

# device_client
# LOW_BW_MODE=0
# LOW_BW_FRAME_SKIP=10
# U2_KEEPALIVE_INTERVAL=3.0
