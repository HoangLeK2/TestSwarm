# Copy to `.env` in this directory for local `pnpm dev`.
# Align NEXT_PUBLIC_* with root `.env` / backend port (default 8081).

# Browser HTTP API: same origin as Next dev server (avoids CORS). Rewrites proxy to farm.
NEXT_PUBLIC_PRODUCT_API_URL=http://localhost:3000
# WebSocket / device-agent still hit the farm host directly (not proxied).
# Dashboard browser WS (operator PC). For QR/device-agent on phones, use your LAN IP:
# NEXT_PUBLIC_DEVICE_FARM_WS_URL=ws://192.168.x.x:8081/ws
NEXT_PUBLIC_DEVICE_FARM_WS_URL=ws://172.16.0.182:8081/ws
NEXT_PUBLIC_ENVIRONMENT=dev

# Next.js rewrites `/api/*` → this URL. Baked at `next build` (Docker build-arg) AND runtime.
DEVICE_FARM_BACKEND_URL=http://172.16.0.182:8081

# NEXT_PUBLIC_DEVICE_FARM_GRID_PREVIEW_EAGER=1
# NEXT_PUBLIC_DEVICE_FARM_PREVIEW_FPS=1
# NEXT_PUBLIC_DEVICE_FARM_GRID_PAGE_SIZE=10
# NEXT_PUBLIC_DEVICE_FARM_GRID_H264_LIMIT=4

# NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DISABLED=1
