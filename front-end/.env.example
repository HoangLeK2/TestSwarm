# Copy to `.env` in this directory for local `pnpm dev`.
# Align NEXT_PUBLIC_* with root `.env` / backend port (default 8081).

NEXT_PUBLIC_PRODUCT_API_URL=http://localhost:8081
NEXT_PUBLIC_DEVICE_FARM_WS_URL=ws://localhost:8081/ws
NEXT_PUBLIC_ENVIRONMENT=dev

# Next.js server rewrites → FastAPI (use service name in Docker, localhost on host).
DEVICE_FARM_BACKEND_URL=http://localhost:8081

# NEXT_PUBLIC_DEVICE_FARM_GRID_PREVIEW_EAGER=1
# NEXT_PUBLIC_DEVICE_FARM_PREVIEW_FPS=8
# NEXT_PUBLIC_DEVICE_FARM_GRID_H264_LIMIT=4

# NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DISABLED=1
