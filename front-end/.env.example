# Copy to `.env` in this directory for local `pnpm dev`.
# Align NEXT_PUBLIC_* with root `.env` / backend port (default 8081).

# Browser HTTP API: call farm backend directly (CORS must allow dashboard origin).
NEXT_PUBLIC_PRODUCT_API_URL=http://localhost:8081
# Control/detail attach may wait for a slow scrcpy cold start. Snapshot previews
# keep their own 10s timeout so one slow phone cannot block the visible grid.
NEXT_PUBLIC_DEVICE_FARM_SCRCPY_ATTACH_TIMEOUT_MS=30000
# Browser-side ICE/STUN servers. Signaling always goes through backend
# /api/media/webrtc. STUN-only policy: do not configure turn: URLs here.
NEXT_PUBLIC_WEBRTC_ICE_URLS=stun:stun.l.google.com:19302
# Cap pre-answer ICE gathering so WebRTC startup stays close to realtime.
NEXT_PUBLIC_WEBRTC_ICE_GATHER_TIMEOUT_MS=180
# Keep transiently unmounted WebRTC previews warm during dashboard scroll/HMR churn.
NEXT_PUBLIC_WEBRTC_TRANSIENT_CLOSE_GRACE_MS=8000
# WebSocket / device-agent hit the farm host directly.
# Dashboard browser WS (operator PC). For QR/device-agent on phones, use your LAN IP:
# NEXT_PUBLIC_DEVICE_FARM_WS_URL=ws://192.168.x.x:8081/ws
NEXT_PUBLIC_DEVICE_FARM_WS_URL=ws://172.16.0.18:8081/ws
NEXT_PUBLIC_ENVIRONMENT=dev
# Control scenario editor: `map` = XYFlow free-layout canvas, `flowgram` = experimental FlowGram fixed-layout canvas, `list` = legacy list fallback.
NEXT_PUBLIC_DEVICE_FARM_CONTROL_EDITOR=map

# NEXT_PUBLIC_DEVICE_FARM_GRID_PREVIEW_EAGER=1
# NEXT_PUBLIC_DEVICE_FARM_PREVIEW_FPS=1
# Dashboard WebRTC previews are tuned for fast first-frame while staying below
# control-screen bitrate/FPS.
NEXT_PUBLIC_DEVICE_FARM_DASHBOARD_WEBRTC_FPS=3
NEXT_PUBLIC_DEVICE_FARM_DASHBOARD_WEBRTC_WIDTH=360
NEXT_PUBLIC_DEVICE_FARM_DASHBOARD_WEBRTC_BITRATE=260000
# NEXT_PUBLIC_DEVICE_FARM_GRID_PAGE_SIZE=10
# Limits simultaneous scrcpy startups, not total visible previews.
# NEXT_PUBLIC_DEVICE_FARM_PREVIEW_ATTACH_CONCURRENCY=3
# Keeps recently offscreen preview streams briefly warm to avoid scroll/re-render churn.
# NEXT_PUBLIC_DEVICE_FARM_SNAPSHOT_WARMUP_RELEASE_GRACE_MS=12000
# Caps idle retained preview streams so fast scrolling cannot keep the whole farm live.
# NEXT_PUBLIC_DEVICE_FARM_SNAPSHOT_WARMUP_RETAINED_IDLE_LIMIT=8
# Migration: NEXT_PUBLIC_DEVICE_FARM_SNAPSHOT_WARMUP_LIMIT is obsolete because
# it capped total viewers and could permanently hide visible phone previews.

# NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DISABLED=1
