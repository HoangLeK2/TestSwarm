  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm run lint:fix && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "eslint src --fix && pnpm format",
    "lint:strict": "eslint --max-warnings=0 src",
    "format": "prettier --write .",
    "format:check": "prettier -c -w .",
    "prepare": "husky",
    "build-and-scan": "./scripts/build-and-scan.sh",
    "gen:api": "swagger-typescript-api generate -p ./generate/openapi.json -o ./src/features/device-farm/services/generated --axios --clean-output --name DeviceFarmApi.ts --api-class-name DeviceFarmHttpClient",
    "gen:api:sync": "cp ../device_farm/swagger/openapi.json ./generate/openapi.json && pnpm gen:api",
    "verify:nav": "node scripts/verify-nav-routes.mjs && node --loader ./scripts/ts-extension-loader.mjs --experimental-strip-types --test src/lib/nav-access.test.ts src/lib/rbac/rbac.test.ts src/features/devices/lib/device-online.test.ts src/features/devices/lib/device-fsm.test.ts src/features/devices/lib/session-owner.test.ts src/features/devices/lib/lifecycle-events.test.ts src/features/devices/lib/lifecycle-cache.test.ts src/features/devices/lib/lifecycle-use-cases.test.ts src/features/devices/lib/lifecycle-message-handler.test.ts src/features/devices/lib/relay-agent-status.test.ts src/features/content/lib/artifact-url.test.ts src/features/content/lib/download.test.ts src/features/content/lib/permalink-flow.test.ts src/features/analytics/lib/activity-deep-link.test.ts",
    "test:content:permalink-e2e": "node --loader ./scripts/ts-extension-loader.mjs --experimental-strip-types --test src/features/content/lib/permalink-flow.test.ts",
    "test:flow-editor": "node --loader ./scripts/ts-extension-loader.mjs --experimental-strip-types --test src/features/campaigns/components/flow-editor/nested-step-edit.test.ts src/features/campaigns/components/flow-editor/bracket-step-tree.test.ts src/features/campaigns/components/flow-editor/flow-tree-dnd.test.ts src/features/campaigns/components/flow-editor/step-retry-policy.test.ts src/features/campaigns/components/flow-editor/crawl-group-scenario.test.ts src/features/campaigns/components/flow-editor/step-tree-perf.test.ts src/features/campaigns/components/flow-editor/inline-run-key.test.ts src/features/scenario-templates/components/scenario-flow-editor/patch-step-tree.test.ts"
  },
