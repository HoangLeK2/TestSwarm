{
  "schema_version": "2.0",
  "scenario": {
    "name": "Crawl Bài Viết 99",
    "description": "Crawl bài viết + bình luận 1 nhóm Facebook liên tục (mặc định MAX_SCROLLS=540 ≈ 3h). Chấp nhận bài trùng lặp — DB dedup qua content_hash, loop không dừng sớm. Navigation: tìm kiếm → tab Nhóm → tap nhóm qua text. Scroll neo trái (SCROLL_X_RATIO=0.18) tránh mở ảnh. Mỗi bài: mở chi tiết → extract posts → back feed → cuộn nhẹ lộ nút Bình luận → atomic tap + switch filter → extract comments → back.\n",
    "kind": "sequence",
    "tags": [
      "crawl",
      "facebook",
      "group"
    ],
    "scenario_version": 8,
    "body": {
      "steps": [
        {
          "id": "iMixNu6wjA",
          "order": "a0",
          "type": "stop_app",
          "package": "com.facebook.katana",
          "error_policy": "stop",
          "pre_capture": true,
          "post_capture": true,
          "retry": null,
          "config": {}
        },
        {
          "type": "launch_app",
          "package": "com.facebook.katana",
          "title": "mở fb",
          "id": "s-1",
          "error_policy": "stop",
          "pre_capture": true,
          "post_capture": true,
          "retry": null,
          "config": {}
        },
        {
          "type": "if_element",
          "by": "description",
          "value": "Tìm kiếm",
          "timeout": 5,
          "then": [
            {
              "type": "tap_selector",
              "by": "description",
              "value": "Tìm kiếm",
              "timeout": 4,
              "selector": {
                "by": "description",
                "value": "Tìm kiếm"
              },
              "id": "s-2-then-1"
            }
          ],
          "else": [
            {
              "type": "tap_ratio",
              "x": 0.87,
              "y": 0.035,
              "id": "s-2-else-1"
            }
          ],
          "selector": {
            "by": "description",
            "value": "Tìm kiếm"
          },
          "id": "s-2",
          "error_policy": "stop",
          "pre_capture": true,
          "post_capture": true,
          "retry": null,
          "config": {}
        },
        {
          "type": "wait_stable",
          "timeout": 4,
          "stable_duration": 0.4,
          "id": "s-3",
          "error_policy": "stop",
          "pre_capture": true,
          "post_capture": true,
          "retry": null,
          "config": {}
        },
        {
          "type": "input_text",
          "text": "${GROUP_NAME}",
          "via": "u2",
          "id": "s-4",
          "error_policy": "stop",
          "pre_capture": true,
          "post_capture": true,
          "retry": null,
          "config": {}
        },
        {
          "type": "key",
          "key": "enter",
          "id": "s-5",
          "error_policy": "stop",
          "pre_capture": true,
          "post_capture": true,
          "retry": null,
          "config": {}
        },
        {
          "type": "if_element",
          "by": "description",
          "value": "Kết quả tìm kiếm trong tab Nhóm, 3 trong số 7",
          "timeout": 5,
          "then": [
            {
              "type": "tap_selector",
              "by": "description",
              "value": "Kết quả tìm kiếm trong tab Nhóm, 3 trong số 7",
              "timeout": 4,
              "selector": {
                "by": "description",
                "value": "Kết quả tìm kiếm trong tab Nhóm, 3 trong số 7"
              },
              "id": "s-6-then-1"
            }
          ],
          "else": [
            {
              "type": "if_element",
              "by": "text",
              "value": "Nhóm",
              "timeout": 3,
              "then": [
                {
                  "type": "tap_selector",
                  "by": "text",
                  "value": "Nhóm",
                  "timeout": 3,
                  "selector": {
                    "by": "text",
                    "value": "Nhóm"
                  },
                  "id": "s-6-else-1-then-1"
                }
              ],
              "else": [
                {
                  "type": "if_element",
                  "by": "text",
                  "value": "Groups",
                  "timeout": 3,
                  "then": [
                    {
                      "type": "tap_selector",
                      "by": "text",
                      "value": "Groups",
                      "timeout": 3,
                      "selector": {
                        "by": "text",
                        "value": "Groups"
                      },
                      "id": "s-6-else-1-else-1-then-1"
                    }
                  ],
                  "else": [],
                  "selector": {
                    "by": "text",
                    "value": "Groups"
                  },
                  "id": "s-6-else-1-else-1"
                }
              ],
              "selector": {
                "by": "text",
                "value": "Nhóm"
              },
              "id": "s-6-else-1"
            }
          ],
          "selector": {
            "by": "description",
            "value": "Kết quả tìm kiếm trong tab Nhóm, 3 trong số 7"
          },
          "id": "s-6",
          "error_policy": "stop",
          "pre_capture": true,
          "post_capture": true,
          "retry": null,
          "config": {}
        },
        {
          "type": "wait_stable",
          "timeout": 1,
          "stable_duration": 0.5,
          "id": "s-7",
          "error_policy": "stop",
          "pre_capture": true,
          "post_capture": true,
          "retry": null,
          "config": {}
        },
        {
          "type": "tap_selector",
          "by": "description",
          "value": "OpenClaw Việt Nam - Giao Lưu, Chia Sẻ,Công khai · 98K thành viên · 4 bài viết/ngày",
          "timeout": 8,
          "selector": {
            "by": "description",
            "value": "OpenClaw Việt Nam - Giao Lưu, Chia Sẻ,Công khai · 98K thành viên · 4 bài viết/ngày",
            "conditions": {
              "className": "android.widget.Button",
              "clickable": true,
              "packageName": "com.facebook.katana"
            }
          },
          "id": "s-8",
          "error_policy": "stop",
          "pre_capture": true,
          "post_capture": true,
          "retry": null,
          "fallback": {
            "rx": 0.583,
            "ry": 0.502
          },
          "fallback_rx": 0.583,
          "fallback_ry": 0.502,
          "config": {}
        },
        {
          "type": "scroll_down",
          "repeats": 2,
          "start_x_ratio": "${SCROLL_X_RATIO}",
          "start_y_ratio": 0.65,
          "end_y_ratio": 0.47,
          "id": "s-9",
          "error_policy": "stop",
          "pre_capture": true,
          "post_capture": true,
          "retry": null,
          "config": {}
        },
        {
          "type": "wait",
          "seconds": 3,
          "id": "s-10",
          "error_policy": "stop",
          "pre_capture": true,
          "post_capture": true,
          "retry": null,
          "config": {}
        },
        {
          "type": "loop",
          "count": "${MAX_SCROLLS}",
          "steps": [
            {
              "type": "extract",
              "strategy": "fb_posts",
              "edge_extra_data": true,
              "extract_profile": "${EXTRACT_PROFILE}",
              "strategy_version": "${FB_POSTS_STRATEGY_VERSION}",
              "open_post_before_extract": true,
              "open_post_press_back_after_extract": false,
              "expand_see_more": true,
              "expand_see_more_max_passes": 2,
              "expand_see_more_scroll": true,
              "expand_see_more_scroll_distance": 0.25,
              "expand_completion_retries": 2,
              "stop_if_no_new": false,
              "collection": "${SAVE_COLLECTION}",
              "platform": "facebook",
              "content_type": "fb_post",
              "dedupe_field": "post_key",
              "tags": "group,crawl,${GROUP_NAME}",
              "id": "s-11-steps-2"
            },
            {
              "type": "tap_fb_comment_button",
              "timeout": 5,
              "pre_scroll": true,
              "pre_scroll_distance": 0.24,
              "post_tap_wait_s": 0.6,
              "enter_comment_sheet_timeout": 2,
              "switch_to_all_comments": true,
              "then": [
                {
                  "type": "extract",
                  "strategy": "fb_comments",
                  "edge_extra_data": true,
                  "extract_profile": "${EXTRACT_PROFILE}",
                  "strategy_version": "${FB_COMMENTS_STRATEGY_VERSION}",
                  "parent_post_id_var": "_fb_comment_parent_pid",
                  "max_items": "${MAX_COMMENTS_PER_POST}",
                  "comment_scroll_passes": "${MAX_COMMENT_SCROLLS}",
                  "comment_swipes_per_dump": 3,
                  "comment_scroll_distance": 0.3,
                  "comment_scroll_duration_ms": 300,
                  "comment_scroll_pause_s": 0.12,
                  "comment_no_growth_break": "${COMMENT_NO_NEW_THRESHOLD}",
                  "min_comment_scan_passes": "${MIN_COMMENT_SCAN_PASSES}",
                  "stop_if_no_new": false,
                  "no_new_threshold": 4,
                  "collection": "${SAVE_COLLECTION}",
                  "platform": "facebook",
                  "content_type": "fb_comment",
                  "dedupe_field": "comment_key",
                  "tags": "group,comment,${GROUP_NAME}",
                  "save_parent_id_var": "_active_comment_parent_hash",
                  "item_level": 1,
                  "id": "s-11-steps-5-then-2"
                },
                {
                  "type": "key",
                  "key": "back",
                  "id": "s-11-steps-5-then-3"
                },
                {
                  "type": "wait",
                  "seconds": 1,
                  "id": "s-11-steps-5-then-4"
                },
                {
                  "type": "dismiss_popup",
                  "retries": 1,
                  "id": "s-11-steps-5-then-5"
                }
              ],
              "else": [],
              "id": "s-11-steps-5"
            },
            {
              "id": "jSLeabqEOx",
              "order": "a0",
              "type": "swipe_ratio",
              "x1": 0.52,
              "y1": 0.959,
              "x2": 0.514,
              "y2": 0.405,
              "duration_ms": 300
            }
          ],
          "id": "s-11",
          "error_policy": "stop",
          "pre_capture": true,
          "post_capture": true,
          "retry": null,
          "config": {}
